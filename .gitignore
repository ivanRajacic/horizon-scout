# virtual environments
.venv/
.venv-rocm/

# API keys (loaded by src/config.py)
.env

# python caches
__pycache__/
*.pyc
.pytest_cache/

# data: raw inputs, generated DB/index, model weights, runtime logs
data/raw/
data/processed/
data/models/
data/logs/
# bank-runner output: records.jsonl carries whole chunk texts, so a run is
# megabytes. A report worth keeping goes into the repo deliberately, by hand.
data/runs/

# server / process logs
*.log

# local Claude Code permission settings
.claude/settings.local.json

# private working docs - local only
docs/*
!docs/assets/
working-plan.md

# image workshop - local only; only the three SVGs the README shows stay tracked
docs/assets/*
!docs/assets/themes/
docs/assets/themes/*
!docs/assets/themes/t3-light/
docs/assets/themes/t3-light/*
!docs/assets/themes/t3-light/explore-corpus-flow.svg
!docs/assets/themes/t3-light/results-strip.svg
!docs/assets/themes/t3-light/failure-split.svg
!docs/assets/themes/t3-light/loop-v2/
docs/assets/themes/t3-light/loop-v2/*
!docs/assets/themes/t3-light/loop-v2/draft-loop-c.svg
