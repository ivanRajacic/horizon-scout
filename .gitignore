# virtual environments
.venv/
.venv-rocm/

# API keys (loaded by src/config.py)
.env

# python caches
__pycache__/
*.pyc
.pytest_cache/

# data: raw inputs, generated DB/index, model weights, runtime logs
data/raw/
data/processed/
data/models/
data/logs/
# bank-runner output: records.jsonl carries whole chunk texts, so a run is
# megabytes. A report worth keeping goes into the repo deliberately, by hand.
data/runs/

# server / process logs
*.log

# local Claude Code permission settings
.claude/settings.local.json
